<Project>

    <!-- Packaging defaults. Two ways in, both for Release builds only:
         - a project that sets IsPackable=true itself (a dotnet tool, say) always gets them, with or without the switch and
           whatever its OutputType. That is what this file always did for such a project;
         - a repository that sets DevConfigsPackageDefaults=true in its root Directory.Build.props, BEFORE importing
           DevConfigs/Directory.Build.props, gets them for every library (OutputType Library, not a test project, not
           IsPackable=false). It is a switch and not something inferred, because "a library" is also every internal library
           of an application, and embedding its sources in a pdb that ships with the app leaks them.
         IsPackable has no value yet while this file is evaluated for a project that relies on the SDK default (the pack
         targets set it later), which is why the default case needs the switch and why "packable" is tested as
         "not explicitly false" there; testing it as '== true' leaves the library case silently dead.
         Executables and test projects (IsPackable=false, set in the props file) get none of it. -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' And '$([System.String]::Copy($(IsPackable)).ToLower())' == 'true' ">
        <DevConfigsExplicitlyPackable>true</DevConfigsExplicitlyPackable>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(DevConfigsPackageDefaults)' == 'true' And '$(Configuration)' == 'Release' And '$([System.String]::Copy($(IsPackable)).ToLower())' != 'false' And '$([System.String]::Copy($(IsTestProject)).ToLower())' != 'true' And '$(OutputType)' == 'Library' ">
        <DevConfigsPackableLibrary>true</DevConfigsPackableLibrary>
    </PropertyGroup>

    <!-- A project keeps what it sets itself: every default is only applied while the property is still empty. -->
    <PropertyGroup Condition=" '$(DevConfigsExplicitlyPackable)' == 'true' Or '$(DevConfigsPackableLibrary)' == 'true' ">
        <DeterministicSourcePaths Condition=" '$(DeterministicSourcePaths)' == '' ">true</DeterministicSourcePaths>
        <EnableSourceLink Condition=" '$(EnableSourceLink)' == '' ">true</EnableSourceLink>
        <PublishRepositoryUrl Condition=" '$(PublishRepositoryUrl)' == '' ">true</PublishRepositoryUrl>
        <PackageRequireLicenseAcceptance Condition=" '$(PackageRequireLicenseAcceptance)' == '' ">false</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression Condition=" '$(PackageLicenseExpression)' == '' And '$(PackageLicenseFile)' == '' And '$(PackageLicense)' == '' ">MIT</PackageLicenseExpression>
        <!-- Embedded sources need a pdb to live in (DebugType=none fails with CS2045); a symbol package needs a standalone
             one (DebugType=embedded fails with NU5017 on the empty .snupkg). SymbolPackageFormat already holds the SDK
             default (symbols.nupkg) here, so an explicit symbols.nupkg cannot be told from "unset" and becomes snupkg. -->
        <EmbedAllSources Condition=" '$(EmbedAllSources)' == '' And '$(DebugType)' != 'none' ">true</EmbedAllSources>
        <IncludeSymbols Condition=" '$(IncludeSymbols)' == '' And '$(DebugType)' != 'none' And '$(DebugType)' != 'embedded' ">true</IncludeSymbols>
        <SymbolPackageFormat Condition=" '$(IncludeSymbols)' == 'true' And ('$(SymbolPackageFormat)' == '' Or '$(SymbolPackageFormat)' == 'symbols.nupkg') ">snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- A README.md next to the project file becomes the package readme, but only when the project has one and did not
         name a readme itself (its own PackageReadmeFile wins, and so does its own item that packs the file); a project
         without a README.md is left as it was, because a PackageReadmeFile that points at nothing fails the pack. -->
    <PropertyGroup Condition=" ('$(DevConfigsExplicitlyPackable)' == 'true' Or '$(DevConfigsPackableLibrary)' == 'true') And '$(PackageReadmeFile)' == '' And Exists('$(MSBuildProjectDirectory)/README.md') ">
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <DevConfigsReadmeDefault>true</DevConfigsReadmeDefault>
    </PropertyGroup>
    <ItemGroup Condition=" '$(DevConfigsReadmeDefault)' == 'true' ">
        <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="" Link="README.md"/>
    </ItemGroup>

    <!-- Only for a project that sets IsPackable=true itself, as before: pack on every Release build. The default (library)
         case does not get it, it would pack every library on each build and again in a consumer's own pack step. -->
    <PropertyGroup Condition=" '$(DevConfigsExplicitlyPackable)' == 'true' ">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <!-- XML docs: Directory.Build.props defaults GenerateDocumentationFile to true in Release when the switch is on and
         marks it with DevConfigsDocDefault, so the SDK derives DocumentationFile and the output copy itself, and a
         project's own explicit value (false included) wins. What is left to do here is to take the default back from
         everything that is not a packable library (executables, test projects, IsPackable=false), after the SDK has
         already derived DocumentationFile from it; a cleared DocumentationFile leaves nothing to compile or copy. An
         explicit GenerateDocumentationFile=true, or a DocumentationFile path, on such a project cannot be told from the
         default and is taken back as well. -->
    <PropertyGroup Condition=" '$(DevConfigsDocDefault)' == 'true' And '$(DevConfigsPackableLibrary)' != 'true' ">
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <DocumentationFile></DocumentationFile>
    </PropertyGroup>

    <!-- The switch only works when it is set before the props import: the docs default is decided there. Set afterwards,
         the symbols, embedded sources and SourceLink would apply but the docs would not, and a package that went out
         that way cannot be replaced. -->
    <Target Name="DevConfigsCheckPackageDefaultsSwitch" BeforeTargets="BeforeBuild;BeforeResolveReferences">
        <Error Condition=" '$(DevConfigsPackageDefaults)' == 'true' And '$(_DevConfigsSwitchSeenByProps)' != 'true' "
               Text="DevConfigsPackageDefaults is set, but it was set after DevConfigs/Directory.Build.props was imported (or that file was not imported), so the XML docs default is not applied. Set DevConfigsPackageDefaults before importing DevConfigs/Directory.Build.props."/>
    </Target>

    <PropertyGroup Condition="'$(TargetFramework)' == '$(TargetFrameworkId)'">
        <EFCoreVersion>$(DotNetNugetsVersion)</EFCoreVersion>
        <BulkExtensionsVersion>[10.0.1]</BulkExtensionsVersion>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(TargetFramework)' == '$(StandardTargetFrameworkId)'">
        <EFCoreVersion>[3.1.32]</EFCoreVersion>
        <BulkExtensionsVersion>[3.6.6]</BulkExtensionsVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == '$(LatestStandardTargetFrameworkId)'">
        <EFCoreVersion>[3.1.32]</EFCoreVersion>
        <BulkExtensionsVersion>[3.6.6]</BulkExtensionsVersion>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(TargetFramework)' == '$(WindowsTargetFrameworkId)'">
        <EFCoreVersion>$(DotNetNugetsVersion)</EFCoreVersion>
        <BulkExtensionsVersion>[10.0.1]</BulkExtensionsVersion>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(TargetFramework)' == '$(FullTargetFrameworkId)'">
        <EFCoreVersion>[3.1.32]</EFCoreVersion>
        <BulkExtensionsVersion>[3.6.6]</BulkExtensionsVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory).editorconfig" Link=".editorconfig"/>
    </ItemGroup>

    <!-- An .editorconfig governs only the files beneath it, so the one in this submodule never reaches a consumer's
         sources: neither the compiler nor `dotnet format` reads it, only the IDE link above displays it. A repository
         that sets DevConfigsMirrorEditorConfig=true in its root Directory.Build.props, BEFORE importing
         DevConfigs/Directory.Build.props, gets a copy of it at its root, the parent of this submodule's directory, on
         every restore and build (list /.editorconfig in that repository's .gitignore). It is a switch: turning the
         shared rules on makes every severity in the file count in that repository's build, which must be measured there
         first.
         - The .gitmodules guard keeps a build that is not inside a consumer from writing a root-level file into whatever
           directory happens to contain the clone: that file would govern every sibling beneath it.
         - A root file the consumer owns is never replaced: only a file carrying the marker line of the shared one is
           overwritten, anything else is left alone with a warning.
         - The compiler reads its .editorconfig list at evaluation, before this target runs, so a build that skips restore
           (no restore step) while the copy is missing compiles without the shared rules; the next build has them.
         - Every project of a parallel restore runs this target at once, so the copy is written to a unique temporary file
           and renamed over the root one, and a read or a rename that loses to a sibling is retried: a plain Copy let one
           project read the file while another held it open for writing (MSB4184 on a CI restore of the solution). A
           failure that outlasts the retries (a read-only file or root) is the DEVCFG002 error, never a green build
           under stale or missing rules. -->
    <UsingTask TaskName="DevConfigsMirrorFile" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Source ParameterType="System.String" Required="true"/>
            <Destination ParameterType="System.String" Required="true"/>
            <Marker ParameterType="System.String" Required="true"/>
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Threading"/>
            <Code Type="Fragment" Language="cs"><![CDATA[
var wanted = File.ReadAllBytes(Source);
var lastError = "";
for (var attempt = 0; attempt < 20; attempt++)
{
    try
    {
        if (File.Exists(Destination))
        {
            var current = File.ReadAllBytes(Destination);
            if (!Encoding.UTF8.GetString(current).TrimStart('\uFEFF').StartsWith(Marker, StringComparison.Ordinal))
            {
                Log.LogWarning(null, "DEVCFG001", null, null, 0, 0, 0, 0, Destination + " is not a mirrored copy, so DevConfigsMirrorEditorConfig left it alone and the shared rules do not apply. Remove it, or stop setting the switch.");
                return true;
            }
            if (current.SequenceEqual(wanted))
            {
                return true;
            }
        }
        var temporary = Destination + "." + Guid.NewGuid().ToString("N") + ".tmp";
        try
        {
            File.WriteAllBytes(temporary, wanted);
            // Both are a rename: atomic on Linux, and on Windows a sibling holding the file open fails it, and it retries.
            if (File.Exists(Destination))
            {
                File.Replace(temporary, Destination, null);
            }
            else
            {
                File.Move(temporary, Destination);
            }
        }
        finally
        {
            File.Delete(temporary);
        }
        return true;
    }
    catch (Exception exception) when (exception is IOException || exception is UnauthorizedAccessException)
    {
        lastError = exception.Message;
        Thread.Sleep(50);
    }
}
// A sibling may have written the same bytes while this one kept losing; anything else is a lasting failure.
bool mirrored;
try
{
    mirrored = File.Exists(Destination) && File.ReadAllBytes(Destination).SequenceEqual(wanted);
}
catch (Exception exception) when (exception is IOException || exception is UnauthorizedAccessException)
{
    mirrored = false;
    lastError = exception.Message;
}
if (!mirrored)
{
    Log.LogError(null, "DEVCFG002", null, null, 0, 0, 0, 0, Destination + " could not be mirrored: " + lastError);
}
]]></Code>
        </Task>
    </UsingTask>
    <Target Name="DevConfigsMirrorEditorConfig" BeforeTargets="CollectPackageReferences;BeforeBuild"
            Condition=" '$(DevConfigsMirrorEditorConfig)' == 'true' And Exists('$(MSBuildThisFileDirectory)../.gitmodules') ">
        <DevConfigsMirrorFile Source="$(MSBuildThisFileDirectory).editorconfig"
                              Destination="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))/.editorconfig"
                              Marker="# Mirrored copy marker"/>
    </Target>

    <ItemGroup Condition=" '$([System.String]::Copy($(IsPackable)).ToLower())' == 'true' ">
        <!-- 10.0.303 is the first release whose Microsoft.Build.Tasks.Git clears GHSA-23fw-v26w-5fgq
             (moderate, information disclosure); 10.0.300 and 10.0.301 both carry it. Do not pin below it.
             Kept on every packable build, whatever the Configuration or the package-defaults switch: items are evaluated
             after IsPackable has its final value, which is why this one condition works while the property conditions above cannot. -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IDisposableAnalyzers.Reloaded" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="ReflectionAnalyzers" Version="0.3.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Polyfills System.Diagnostics.CodeAnalysis nullable attributes (NotNullWhen, NotNull,
             MaybeNull, MemberNotNull, ...) on down-level targets (netstandard2.0, net481, and
             MemberNotNull* on netstandard2.1) so nullable annotations compile on every TFM.
             Source generator only, PrivateAssets=all -> no runtime, not exposed to consumers. -->
        <PackageReference Include="PolySharp" Version="1.16.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition=" $(MSBuildProjectName.EndsWith('.Tests')) " >
        <None Remove="coverage.cobertura.xml"/>
        <Compile Remove="TestResults\**" />
        <EmbeddedResource Remove="TestResults\**" />
        <None Remove="TestResults\**" />
    </ItemGroup>

</Project>
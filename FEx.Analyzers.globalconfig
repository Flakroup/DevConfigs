is_global = true
# FEx.Analyzers (the package Directory.Build.targets references) at error, one line per rule ID, so a new rule is a
# deliberate line here and a rule a package version adds stays at its default until then. FEX0001-FEX0053 are the rules of
# FEx.Analyzers 0.4.0-alpha.378. Wired through GlobalAnalyzerConfigFiles in Directory.Build.props.

is_global = true
# IDE0005 (unnecessary usings) runs in a build only where XML documentation is generated (dotnet/roslyn#41640) -
# in a library's Release build under the packaging defaults, for one. Everywhere else, with EnforceCodeStyleInBuild
# on, the compiler reports EnableGenerateDocumentationFile in its place, once per project: a diagnostic about a
# setting, not about code, and one no build reported before that switch. Turning documentation on everywhere costs
# thousands of CS1591 and hundreds of XML-doc errors, so there unused usings stay with `dotnet format` (the
# consumer's pre-commit hook and CI), which needs no documentation output. The line lives here and not in
# .editorconfig because a diagnostic without a source location obeys a global configuration only.
dotnet_diagnostic.EnableGenerateDocumentationFile.severity = none

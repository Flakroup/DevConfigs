<!-- DEV NOTES
- MSBuild boolean values are written as 'true' or 'false' (lowercase)
- Custom boolean values are written as 'True' or 'False' (uppercase)
 -->
<Project TreatAsLocalProperty="NuGetAudit;NuGetAuditMode">

    <PropertyGroup>
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <Authors>Flakroup</Authors>
        <Company>Flakroup</Company>
        <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
        <!-- The IDE rules .editorconfig raises run in every build, not only in the editor and `dotnet format`. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <Copyright>Copyright © Flakroup 2025-2026</Copyright>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <Nullable>enable</Nullable>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <RepositoryType>git</RepositoryType>
        <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
        <WarningLevel>7</WarningLevel>
        <WarningsAsErrors>$(WarningsAsErrors);CS0660;CA1068;SI2100</WarningsAsErrors>
        <!-- SI2100: No source for instance of Type used in optional parameter -->
        <!-- CS1591 (missing XML comment) stays a warning even when a consumer sets TreatWarningsAsErrors=true.
             The other doc diagnostics (CS1572, CS1573, CS1574, CS1584, CS1658, ...) stay errors there on purpose. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
        <WarnOnPackingNonPackableProject>true</WarnOnPackingNonPackableProject>
    </PropertyGroup>

    <!-- Declared here and not in Directory.Build.targets: the SDK folds GlobalAnalyzerConfigFiles into the compiler's
         analyzer configuration at evaluation, so an item declared after its targets are imported never reaches csc. -->
    <ItemGroup>
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)build.globalconfig" />
    </ItemGroup>

    <!-- XML docs default, only for a repository that opted in with DevConfigsPackageDefaults=true (set before the import
         of this file; the private marker lets Directory.Build.targets notice a switch set too late). A project's own value
         wins over the default, explicit false included; the DevConfigsDocDefault marker lets Directory.Build.targets take
         the default back from what is not a package. Without the switch the property stays false, as it always was, which
         also keeps a project that sets only DocumentationFile from compiling docs. -->
    <PropertyGroup Condition=" '$(DevConfigsPackageDefaults)' == 'true' ">
        <_DevConfigsSwitchSeenByProps>true</_DevConfigsSwitchSeenByProps>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(DevConfigsPackageDefaults)' != 'true' ">
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(DevConfigsPackageDefaults)' == 'true' And '$(Configuration)' == 'Release' And '$(GenerateDocumentationFile)' == '' ">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DevConfigsDocDefault>true</DevConfigsDocDefault>
    </PropertyGroup>

    <PropertyGroup Condition=" $(MSBuildProjectName.EndsWith('.Tests')) ">
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <!-- Microsoft.Testing.Platform (MTP) runner instead of the VSTest adapter: tests build as an Exe
             and `dotnet test` drives the native runner (same path as running the test Exe directly). -->
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- One TRX report per test project, named after it. xUnit names it <user>_<machine>_<timestamp>.trx by
             default, so two assemblies of one solution-wide `dotnet test` that start in the same microsecond write one file
             and one report silently replaces the other. In MTP mode `dotnet test` puts RunArguments, which the SDK fills
             from StartArguments, in front of its own options on each assembly's command line. The report switch comes
             along because xUnit rejects the file name without it (exit 5), and MTP takes the switch twice when the run
             passes it as well. A run that passes a file name of its own gets two and fails (exit 5); a multi-targeted
             test project gets one name for every framework, so each run replaces the last one's report. -->
        <StartArguments>--report-xunit-trx --report-xunit-trx-filename $(MSBuildProjectName).trx</StartArguments>
        <NoWarn>$(NoWarn);VSTHRD200</NoWarn>
        <!-- VSTHRD200: Use Async suffix for async methods - https://github.com/microsoft/vs-threading/blob/main/doc/analyzers/VSTHRD200.md -->
        <WarningsAsErrors>$(WarningsAsErrors),NS2002</WarningsAsErrors>
        <!-- NS2002: Constructor parameters count mismatch - https://github.com/nsubstitute/NSubstitute.Analyzers/blob/master/documentation/rules/NS2002.md -->
    </PropertyGroup>

    <PropertyGroup Condition=" '$([System.String]::Copy($(IsTestProject)).ToLower())' == 'false' ">
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', '$(TargetFrameworkId)'))">true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' Or '$(TF_BUILD)' == 'true' ">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- Custom properties-->
    <PropertyGroup>
        <TargetFrameworkId>net10.0</TargetFrameworkId>
        <FullTargetFrameworkId>net481</FullTargetFrameworkId>
        <StandardTargetFrameworkId>netstandard2.0</StandardTargetFrameworkId>
        <LatestStandardTargetFrameworkId>netstandard2.1</LatestStandardTargetFrameworkId>
        <FullTargetFrameworkIds>$(FullTargetFrameworkId);$(LatestStandardTargetFrameworkId);$(TargetFrameworkId)</FullTargetFrameworkIds>
        <StandardTargetFrameworkIds>$(TargetFrameworkId);$(LatestStandardTargetFrameworkId);$(StandardTargetFrameworkId)</StandardTargetFrameworkIds>
        <WindowsTargetFrameworkId>$(TargetFrameworkId)-windows</WindowsTargetFrameworkId>
        <WindowsTargetFrameworkIds>$(FullTargetFrameworkId);$(WindowsTargetFrameworkId)</WindowsTargetFrameworkIds>
        <DotNetNugetsVersion>[10.0.12]</DotNetNugetsVersion>
        <AvaloniaVersion>12.0.4</AvaloniaVersion>
        <!-- Microsoft.Testing.Platform and the HangDump extension, which is bound to the platform's internals, on one number. The other MTP packages (Telemetry, MSBuild, TrxReport) arrive transitively through xunit and the coverage extension at whatever they ask for: raising this means checking those resolve to it too. -->
        <MtpVersion>2.4.0</MtpVersion>
    </PropertyGroup>

    <ItemGroup Condition=" '$([System.String]::Copy($(IsTestProject)).ToLower())' == 'true' ">
        <!-- MTP test stack - pinned (floating '*' drifts Testing.Platform versions and breaks the runner). -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2"/>
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="$(MtpVersion)"/>
        <PackageReference Include="Microsoft.Testing.Platform" Version="$(MtpVersion)"/>
        <PackageReference Include="NSubstitute" Version="6.2.0"/>
        <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Shouldly" Version="4.3.0"/>
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1"/>
        <PackageReference Include="xunit.analyzers" Version="2.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>